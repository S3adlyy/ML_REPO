# Copy to .env for local configuration; Django loads .env automatically.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-replace-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Firebase Console > Project settings > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Absolute path to server-only service account JSON (never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=
# On a managed host with Application Default Credentials, set to 1 instead
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=0

# Render production (do not set these for ordinary local SQLite development)
# DATABASE_URL=postgresql://...
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# MODEL_BUNDLE_URL=https://approved-storage.example/prisma-models-v1.zip
